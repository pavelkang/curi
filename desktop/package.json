{
  "author": "Curi",
  "build": {
    "appId": "com.curi.creator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": "dmg"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false
    },
    "productName": "Curi Creator",
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    }
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "description": "Curi Creator \u2014 desktop creator app for Curi: Studio, OBS-file import, and local captions. First slice.",
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "license": "MIT",
  "main": "src/main.js",
  "name": "curi-creator",
  "scripts": {
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/caption-worker.js && node --check src/captions-renderer.js && node scripts/check-shared.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "start": "electron .",
    "start:dev": "CURI_STUDIO_URL=http://localhost:3100/studio electron . --no-sandbox",
    "check:shared": "node scripts/check-shared.js"
  },
  "version": "0.1.0"
}
