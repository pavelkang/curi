# Copy to .env.local and fill in real values. Never commit .env.local.
# No real secrets are in this repo; these are placeholder names only.

# Supabase (public, safe to expose in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role (SERVER ONLY, used by the Mux webhook handler).
# Never prefix with NEXT_PUBLIC_, never put it in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mux Video API (server only, used by /api/mux/* routes)
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret

# Mux webhook signing secret (server only). Set the webhook endpoint in
# the Mux dashboard to <your-site>/api/mux/webhook and copy its secret here.
MUX_WEBHOOK_SECRET=your-mux-webhook-secret

# Public site URL, used for docs/links only in MVP
NEXT_PUBLIC_SITE_URL=http://localhost:3000
